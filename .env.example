# PaperDesk settings. Copy to .env. Never commit .env.
# Every setting here is read from .env by the server, by run.sh and run.bat (HOST, PORT and the access
# settings) and by docker compose. Variables already set in the environment win over .env.
# By default PaperDesk has no login and only this computer can open it.

# Port the server listens on (and that Docker publishes on 127.0.0.1). Default 8000.
PORT=8000

# "always": the simulated market never closes. "us": follow US market hours and holidays.
# Default: "always" with simulated prices, "us" with Alpaca data.
# PAPERDESK_SESSIONS=always

# Seed for the simulated price history (integer). Same seed, same history. Default 7.
PAPERDESK_SEED=7

# Where state is saved. In Docker this is the named volume at /data; leave it alone there.
# Outside Docker the default is backend/data.
# PAPERDESK_DATA=/data
# Automatic backups (docs/STATE_FORMAT.md): seconds between them (0 = off), and how many to keep.
# PAPERDESK_BACKUP_INTERVAL=3600
# PAPERDESK_BACKUP_KEEP_HOURLY=24
# PAPERDESK_BACKUP_KEEP_DAILY=14
# PAPERDESK_BACKUP_KEEP_EVENTS=20

# HOST is the bind address: run.sh/run.bat default to 127.0.0.1 (0.0.0.0 in LAN mode) and refuse a network
# address without LAN mode. The Docker image sets 0.0.0.0 inside the container only. Leave unset.
# HOST=127.0.0.1

# ---- LAN mode: open PaperDesk from a phone on the same home Wi-Fi (off by default) ----
# Plain HTTP: anyone on the same network could watch the traffic. Home network only, never public or
# shared Wi-Fi. Wrap the passcode in single quotes; use at least 8 characters and do not reuse it elsewhere.
# PAPERDESK_LAN=1
# PAPERDESK_PASSCODE='choose a long passcode'
# Docker only: also publish the port on the network (refused unless LAN mode and a passcode are set).
# PAPERDESK_BIND=0.0.0.0
# Sign-ins expire after this many days without use. Default 30.
# PAPERDESK_SESSION_DAYS=30
# 1: browsers on this computer (127.0.0.1) skip the passcode. 0: every browser signs in. Default 1.
# Set 0 if you put a reverse proxy in front: every request would then look like it comes from this computer.
# PAPERDESK_LOOPBACK_BYPASS=1
# Extra host names (comma separated) the server answers to besides IP addresses, e.g. mypc.local.
# PAPERDESK_ALLOWED_HOSTS=

# ---- Market data providers (see docs/DATA_PROVIDERS.md). Never commit real keys. ----
# auto (default): Alpaca when both keys are set, otherwise simulated prices. alpaca or synthetic forces one.
# PAPERDESK_FEED=auto
# Alpaca market data keys (Alpaca's own variable names).
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# Trading host used only for the symbol list and option contracts. Default https://paper-api.alpaca.markets
# APCA_API_BASE_URL=https://paper-api.alpaca.markets
# Stock feed: iex (free, real time), sip (paid) or delayed_sip. Options feed: indicative (free) or opra (paid).
# PAPERDESK_ALPACA_FEED=iex
# PAPERDESK_ALPACA_OPTIONS_FEED=indicative
# REST request budget per minute (the free plan allows 200).
# PAPERDESK_ALPACA_RPM=190
# Optional secondary provider: earnings calendar and fundamentals.
# FINNHUB_API_KEY=

# ---- Advanced (rarely needed) ----
# Folder with the built web UI. Default frontend/dist (the Docker image sets its own).
# PAPERDESK_UI=
# Read settings from this file instead of .env next to run.sh (set it in the environment, not here).
# An empty value means: read no settings file.
# PAPERDESK_ENV_FILE=
# Seconds a request waits for the exchange lock before it answers 503 (busy). Default 2.
# PAPERDESK_LOCK_WAIT=2
# run.bat only: 1 skips opening the browser; 1 skips the pause after an error.
# PAPERDESK_NO_BROWSER=1
# PAPERDESK_NO_PAUSE=1
