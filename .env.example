# PaperDesk settings. Copy to .env (docker compose reads it; run.sh does not). Never commit .env.
# PaperDesk has no login: keep it on 127.0.0.1 and do not expose it to a network.

# Port the server listens on (and that Docker publishes on 127.0.0.1). Default 8000.
PORT=8000

# "always": the simulated market never closes. "us": follow US market hours and holidays.
PAPERDESK_SESSIONS=always

# Seed for the simulated price history (integer). Same seed, same history. Default 7.
PAPERDESK_SEED=7

# Where state is saved. In Docker this is the named volume at /data; leave it alone there.
# Outside Docker the default is backend/data.
# PAPERDESK_DATA=/data

# HOST is the bind address: run.sh/run.bat default to 127.0.0.1. The Docker image sets 0.0.0.0 inside the
# container only. Leave unset unless you know why.
# HOST=127.0.0.1

# ---- Reserved: defined by the market data work, not read by this build yet ----
# Which market data feed to use (for example "synthetic").
# PAPERDESK_FEED=synthetic
# Provider API key variables: names will be defined by the data stream and listed here then. Never commit real keys.
